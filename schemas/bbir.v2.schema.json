{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Rynix01/Formixel/schemas/bbir.v2.schema.json",
  "title": "Formixel BBIR 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "format", "resolution", "cubes", "groups"],
  "properties": {
    "version": {
      "const": 2
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "format": {
      "const": "free"
    },
    "resolution": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8192
      }
    },
    "cubes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/cube"
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "materials": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "textures": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/texture"
      }
    },
    "animations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/animation"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "vector": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": -1000000,
        "maximum": 1000000
      }
    },
    "cube": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "from", "to", "origin", "rotation", "color"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "from": {
          "$ref": "#/$defs/vector"
        },
        "to": {
          "$ref": "#/$defs/vector"
        },
        "origin": {
          "$ref": "#/$defs/vector"
        },
        "rotation": {
          "$ref": "#/$defs/vector"
        },
        "color": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "parent": {
          "$ref": "#/$defs/id"
        },
        "material": {
          "$ref": "#/$defs/id"
        },
        "faces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "north": {
              "$ref": "#/$defs/face"
            },
            "east": {
              "$ref": "#/$defs/face"
            },
            "south": {
              "$ref": "#/$defs/face"
            },
            "west": {
              "$ref": "#/$defs/face"
            },
            "up": {
              "$ref": "#/$defs/face"
            },
            "down": {
              "$ref": "#/$defs/face"
            }
          },
          "required": []
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "origin", "rotation"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "origin": {
          "$ref": "#/$defs/vector"
        },
        "rotation": {
          "$ref": "#/$defs/vector"
        },
        "parent": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uv": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": -8192,
            "maximum": 8192
          }
        },
        "texture": {
          "$ref": "#/$defs/id"
        },
        "rotation": {
          "enum": [0, 90, 180, 270]
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": ["uv"]
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
        }
      },
      "required": ["id", "color"]
    },
    "texture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "pixels": {
          "type": "array",
          "maxItems": 1048576,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      },
      "required": ["id", "name", "width", "height", "pixels"]
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "value": {
          "$ref": "#/$defs/vector"
        },
        "interpolation": {
          "enum": ["linear", "step"]
        }
      },
      "required": ["time", "value", "interpolation"]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "$ref": "#/$defs/id"
        },
        "channel": {
          "enum": ["rotation", "position", "scale"]
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        }
      },
      "required": ["group", "channel", "keyframes"]
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "loop": {
          "type": "boolean"
        },
        "tracks": {
          "type": "array",
          "maxItems": 3000,
          "items": {
            "$ref": "#/$defs/track"
          }
        }
      },
      "required": ["id", "name", "length", "loop", "tracks"]
    }
  },
  "$comment": "Runtime validation additionally enforces hierarchy, IDs and references, finite values, positive dimensions, pixel count and global budget, strictly increasing keyframes, positive animation scale and unique channels. Schema alone is insufficient."
}
